{
  "name": "jev-native-hooks",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "Quality-first Jev native hooks with explicit consent and independent verification.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
