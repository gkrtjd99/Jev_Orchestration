    "doctor": "node scripts/doctor.mjs",
    "install:hooks": "node scripts/install.mjs",
    "uninstall:hooks": "node scripts/uninstall.mjs",
    "eval:router": "node scripts/evaluate-router.mjs",
    "catalog": "node scripts/catalog.mjs",
    "feedback": "node scripts/feedback.mjs",
    "compare:default": "node scripts/compare-default-behavior.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.mjs"
  }
