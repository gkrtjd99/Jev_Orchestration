# Keep this file outside the project; chmod 600. Native logins are separate.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# shadow (default), advisory, active, controller (Claude only), or off.
JEV_MODE=shadow
JEV_ALLOW_EGRESS=false
# Controller critiques require all three explicit flags and a TypeSafe key.
JEV_CONTROLLER_CRITIQUE=false
# Controller telemetry is local opt-in, independent of Jev egress.
JEV_OTEL_ENABLED=false
JEV_OTEL_ENDPOINT=http://127.0.0.1:4318
# Optional when launched through obs run (OTEL_* provides these). Otherwise set real UUIDv4 and ingest token privately.
JEV_OTEL_PROJECT_ID=
JEV_OTEL_INGEST_TOKEN=
JEV_CODEX_REWRITE_APPROVED=false
JEV_CODEX_COLLABORATION_REWRITE_APPROVED=false
JEV_RETAIN_PROMPT_TEXT=false
JEV_SHARE_PLAN_CONTEXT=false
# warn (default) or block; block denies Workflow only in active Claude sessions.
JEV_WORKFLOW_POLICY=warn
JEV_MAX_EFFORT_ALLOWED=true
JEV_ALLOW_ECONOMY_CANDIDATES=false
JEV_READ_ADVICE=false
JEV_OBJECTIVE=balanced
JEV_EVALUATION_CONTEXT=native-default-unvalidated
# Decision kernel (3.2.0). Every line below is commented: skills and supervisor stay off, OpenAI is not approved.
# Skill routing at the delegation boundary and the advisory report supervisor: off (default), shadow (log only) or active.
#JEV_SKILLS_MODE=off
#JEV_SUPERVISOR_MODE=off
# Judge chains, comma-separated in order: jev, openai, local. local is a lexical heuristic for skills only, not calibrated.
#JEV_SKILLS_JUDGES=jev
#JEV_SUPERVISOR_JUDGES=jev
# Applies to delegation.classify, delegation.profile, failure.classify and read.advice.
#JEV_DECISION_JUDGES=jev
# Extra absolute skill directories, separated by the platform path delimiter (':' on POSIX). Project .claude/skills is always scanned.
#JEV_SKILL_DIRS=
# The openai judge sends decision state to api.openai.com. It needs this explicit approval, JEV_ALLOW_EGRESS=true and a key.
#JEV_OPENAI_DECISIONS_APPROVED=false
#JEV_OPENAI_DECISIONS_MODEL=
#OPENAI_API_KEY=
# Local decision log (hashes, numbers and option names only; no prompt or state text).
#JEV_DECISION_LOG=true
