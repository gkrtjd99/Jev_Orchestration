# Local verifier configuration. Never commit a completed .env file.
VERIFY_SUT_PATH=
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Leave blank to test the SUT's real defaults. Altering timeout changes the evaluated configuration.
JEV_TIMEOUT_MS=

# Isolated native runs need API credentials, or opt-in --reuse-cli-login.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
CODEX_API_KEY=
# Existing provider/proxy must be declared explicitly; global settings are not copied.
ANTHROPIC_BASE_URL=
VERIFY_CODEX_BASE_URL=

VERIFY_CLAUDE_MAIN_MODEL=claude-opus-5-5
VERIFY_CODEX_MAIN_MODEL=gpt-6-sol
VERIFY_CLAUDE_MAIN_EFFORT=high
VERIFY_CODEX_MAIN_EFFORT=high
VERIFY_CLAUDE_MAX_TURNS=20
VERIFY_CLAUDE_MAX_BUDGET_USD=3
# Exact alias-to-observed-model mapping, not model-family guessing. Example form only:
VERIFY_MODEL_ALIASES_JSON={}
# Optional executable overrides:
VERIFY_NODE_BIN=
VERIFY_CLAUDE_BIN=
VERIFY_CODEX_BIN=

# Optional SUT model overrides: the original installer requires an explicit effort map.
# Do not set these based on a guessed model capability.
# JEV_CLAUDE_LIGHT_MODEL=
# JEV_CLAUDE_LIGHT_BACKEND=
# JEV_CLAUDE_LIGHT_EFFORT_MAP={"brief":"high","balanced":"xhigh","deep":"xhigh","exhaustive":"max"}

# Additional consent required ONLY when deliberately running real routing stages.
JEV_ALLOW_EGRESS=false
JEV_CODEX_REWRITE_APPROVED=false
